# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Env
.env
.env.local
*.env

# Data & artifacts
# NOTE: leading slash anchors to repo root. Unanchored `data/` also matched
# the SOURCE package src/price_action/data/ and silently excluded it from git
# (broke `from price_action.data.store import OHLCVStore`). Keep the slash.
/data/
!/data/.gitkeep
!/data/README.md
# FIX 2026-05-28 (audit-Y7): pool_manifest.json kod tarafından okunan
# aktif-pool tek-kaynak — repo'da tutulmalı, /data/ ignore'una kurban gitmesin.
!/data/pool_manifest.json
# Test fixtures opsiyonel — gelecekte küçük örneklerin CI'da kullanılabilmesi için.
!/data/test_fixtures/
artifacts/
# FIX 2026-05-28 (audit-F1): archive/ klasörü eski dosya saklama alanı.
# Git history'de zaten varlar; tekrar track etmek disk'te 2× kopya doğurur +
# eski archive dosyaları typo hook'larını trigger ediyor. Disk'te kalsın,
# git takip etmesin.
archive/
reports/*
!reports/PRODUCTION_BENCHMARK.md
logs/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
!tests/**/*.csv

# RAG store
knowledge/index/
knowledge/cache/
*.chroma/
chroma.sqlite3

# Memory runtime
memory/**/runtime/
memory/**/episodic/*.jsonl

# Inter-agent protocol — append-only message bus
memory/protocol/inbox.jsonl
memory/protocol/archive/

# İç denetim findings register — runtime state (dashboard reports/audit/ zaten ignore)
memory/audit/findings_register.jsonl

# Active state ledger — CEO her brief'te last_updated günceller, git spam yapar.
# Schema git'li (template), runtime value git'siz.
memory/shared/active_state.md

# Notebooks
.ipynb_checkpoints/
notebooks/scratch/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Tools
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Docker
.docker/
.env.backup-*

# Claude Code runtime artefaktları (track edilmemeli)
.claude/scheduled_tasks.lock
.claude/settings.local.json
