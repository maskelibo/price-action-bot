venv/
.python-version

# Env
.env
.env.local
*.env

# Data & artifacts
# NOTE: leading slash anchors to repo root. Unanchored `data/` also matched
# the SOURCE package src/price_action/data/ and silently excluded it from git
# (broke `from price_action.data.store import OHLCVStore`). Keep the slash.
/data/
!/data/.gitkeep
!/data/README.md
artifacts/
reports/*
!reports/PRODUCTION_BENCHMARK.md
logs/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
!tests/**/*.csv

# RAG store
knowledge/index/
knowledge/cache/
*.chroma/
chroma.sqlite3

# Memory runtime
memory/**/runtime/
memory/**/episodic/*.jsonl

# Notebooks
.ipynb_checkpoints/
notebooks/scratch/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Tools
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Docker
.docker/
