# =====================================================================
# Price Action — Environment Variables (örnek). Gerçek değerlere .env ile geç.
# =====================================================================

# --- LLM (Claude Agent SDK) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL_DEFAULT=claude-opus-4-7
CLAUDE_MODEL_FAST=claude-sonnet-4-6
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001

# --- Borsa anahtarları (TESTNET ile başla) ---
# Faz 6'ya kadar testnet zorunlu; canlı anahtar Faz 7'de açılır.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Veritabanı / depolama ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=price_action
POSTGRES_USER=pa
POSTGRES_PASSWORD=changeme_in_real_env

DUCKDB_PATH=./data/market.duckdb
PARQUET_ROOT=./data/parquet
CHROMA_PATH=./knowledge/index

# --- Telegram alert (opsiyonel ama Faz 5+ için lazım) ---
# FIX 2026-05-28 (audit-Y5): Telegram bearer token + chat ID burada PLAIN TEXT
# bırakmak güvenlik riski (bot token bearer'dır, rotation mekanizması yok).
# ÖNERİ: ~/.zshrc veya macOS Keychain'e taşı, settings.py os.getenv() ile
# inherit. launchd plist EnvironmentVariables içinde "set yapma, shell'den al":
#   <key>TELEGRAM_BOT_TOKEN</key><string></string>    # boş bırak; plist load
# anında shell environment'tan inheritance ile gelir.
# Yerel dev için .env'de bırakabilirsin; production daemon'da KEYCHAIN tercih.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mac-dışı dead-man (opsiyonel; yoksa dashboard bilinçli WARN) ---
HEALTHCHECKS_PING_URL=
# Yalnız gerçek e-posta/push alarm drill'i alındıktan sonra UTC ISO-8601 yaz:
HEALTHCHECKS_ALARM_DRILL_VERIFIED_AT=

# --- RAG ingestion (opsiyonel — YouTube transkripti vs için) ---
YOUTUBE_API_KEY=

# --- Çalışma modu ---
# backtest | paper | live
#
# !!! DİKKAT — Live mode iki kademeli onay gerektirir:
# !!!   1) PA_RUN_MODE=live (bu env'de)
# !!!   2) PA_LIVE_CONFIRM=YES_I_KNOW (bu env'de)
# !!!   3) configs/risk_*.yaml içinde live_mode_enabled: true
# !!! Üçünden biri eksikse code RuntimeError fırlatır (execution/ccxt_live.py).
# !!! Tek bir env'i yanlışlıkla "live" yapmak yetmez — bu defansif tasarım.
PA_RUN_MODE=backtest
PA_LIVE_CONFIRM=

# --- Backtest ayarı ---
PA_BACKTEST_YEARS=5
# FIX 2026-05-28 (audit-Y5): settings.py default'u "1d,1w,15m" — eski .env.example
# "1d,1w" diyordu (15m eksik) → kopya alanlar 15m daemon'u kazadan kapatabilirdi.
PA_TIMEFRAMES=1d,1w,15m
# universe modu: top_volume | all_liquid | manual
PA_UNIVERSE_MODE=all_liquid
PA_UNIVERSE_MIN_VOL_USDT=1000000

# --- Risk varsayılanları (configs/risk.yaml içindekiler bunları ezer) ---
PA_RISK_PER_TRADE=0.01
PA_MAX_LEVERAGE=3
PA_DAILY_DD_BREAKER=0.05
PA_WEEKLY_DD_BREAKER=0.10

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Faz 6: Paper Trading (Binance Testnet) ---
# Testnet API keys: https://testnet.binance.vision/
# These are separate from production keys — never mix them.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Initial paper capital (USDT)
PA_PAPER_INITIAL_CAPITAL=10000
# Risk per trade fraction (0.02 = %2 — production config)
PA_PAPER_RISK_PER_TRADE=0.02
# Max leverage cap (overridden per-trade by confidence tier; hard ceiling)
PA_PAPER_MAX_LEVERAGE=5

# --- Faz 5: LLM Orchestration + Telegram ---
# Telegram bot kurulumu: https://t.me/BotFather
# Chat ID almak için: @userinfobot'a /start yaz
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Daily brief UTC saati (HH:MM formatı)
PA_LLM_BRIEF_TIME=09:00
# Weekly summary günü (Monday-Sunday)
PA_LLM_WEEKLY_DAY=Sunday
# Breaker monitor poll aralığı (saniye)
PA_BREAKER_POLL_INTERVAL=300
# Optional process-level safety gate. Set this for research/orchestrator
# processes that must never create an authenticated Binance client.
PA_DISABLE_PRIVATE_EXCHANGE_API=0
