<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.priceaction.futures15m_v11</string>

  <!--
    futures_daemon.py 15m + session_vwap_mean_reversion v11 (DEPLOY 2026-05-27).
    Companion: aylık +12.08% / DD -15.36% (LIVE'dan az!) / yıllık +282%
    Spec: configs/risk_phoenix_scalp_15m_vwap_v11.yaml
    Journal: data/futures_journal_vwap.duckdb
    Log: logs/futures_daemon_vwap.log
  -->

  <key>ProgramArguments</key>
  <array>
    <string>/Users/peyman/price-action-bot/.venv/bin/python</string>
    <string>-u</string>
    <string>scripts/futures_daemon.py</string>
    <string>--timeframe</string>
    <string>15m</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/peyman/price-action-bot</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/peyman/price-action-bot/src</string>
    <key>PA_RUN_MODE</key>
    <string>paper</string>
    <key>TZ</key>
    <string>UTC</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PA_15M_CONFIG</key>
    <string>configs/risk_phoenix_scalp_15m_vwap_v11.yaml</string>
    <key>PA_BOT_NAME</key>
    <string>vwap</string>
    <!-- FIX 2026-05-28 (Faz 14.27): read-only mode → ingest cron lock-free -->
    <key>PA_DUCKDB_READ_ONLY</key>
    <string>true</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/peyman/price-action-bot/logs/launchd/futures15m_v11.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/peyman/price-action-bot/logs/launchd/futures15m_v11.stderr.log</string>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>
</dict>
</plist>
