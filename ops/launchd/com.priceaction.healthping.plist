<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- DR1 dış dead-man bekçisi: 5 dk'da bir sağlık-koşullu healthchecks.io ping.
         HEALTHCHECKS_PING_URL .env'de yoksa script inert kalır ve WARN satırı yazar.
         Reboot'ta bu job da ölür (gui domain) → ping kesilir → dış alarm. Tasarım bu. -->
    <key>Label</key><string>com.priceaction.healthping</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/peyman/price-action-bot/scripts/healthcheck_ping.sh</string>
    </array>
    <key>StartInterval</key><integer>300</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>/Users/peyman/price-action-bot/logs/launchd/healthping.stdout.log</string>
    <key>StandardErrorPath</key><string>/Users/peyman/price-action-bot/logs/launchd/healthping.stderr.log</string>
    <key>ProcessType</key><string>Background</string>
</dict>
</plist>
