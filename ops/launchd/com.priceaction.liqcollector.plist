<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.priceaction.liqcollector</string>
  <!-- YOL_HARITASI 2026-07-09 §3d: likidasyon feed collector (Bybit linear).
       Geriye dönük veri VERİLMEZ - kesinti = kalıcı tarih kaybı - KeepAlive.
       Kaynak gerekçesi + Binance-fstream TR-engel kanıtı: scripts/liq_collector.py
       docstring. VPS'e taşınınca Binance backend'i yeniden değerlendirilecek. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/peyman/price-action-bot/.venv/bin/python</string>
    <string>/Users/peyman/price-action-bot/scripts/liq_collector.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/peyman/price-action-bot</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- crash-loop koruması (T8-DR launchd dersleri) -->
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/peyman/price-action-bot/logs/launchd/liqcollector.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/peyman/price-action-bot/logs/launchd/liqcollector.stderr.log</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict>
</plist>
