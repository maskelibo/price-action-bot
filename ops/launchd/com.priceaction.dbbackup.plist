<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.priceaction.dbbackup</string>

  <!--
    FIX 2026-05-28 (audit-A9): otomatik DuckDB backup — günlük 03:00 TR (00:00 UTC).
    3 günlük rolling backup (PA_BACKUP_RETENTION_DAYS=3 env ezer; script default 7 — D16 çelişkisi yorum-tarafı düzeltildi 2026-07-10; retention DEĞERİ kararı Principal'de). scripts/backup_duckdb.sh çalıştırır.

    Load:    launchctl bootstrap gui/501 ~/Library/LaunchAgents/com.priceaction.dbbackup.plist
    Unload:  launchctl bootout gui/501 ~/Library/LaunchAgents/com.priceaction.dbbackup.plist
    Manual:  launchctl kickstart gui/501/com.priceaction.dbbackup
    Test:    bash scripts/backup_duckdb.sh --dry-run
  -->

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/peyman/price-action-bot/scripts/backup_duckdb.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/peyman/price-action-bot</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PA_PROJECT_ROOT</key>
    <string>/Users/peyman/price-action-bot</string>
    <key>PA_BACKUP_RETENTION_DAYS</key>
    <string>3</string>
  </dict>

  <!-- Gece 03:00 TR = 00:00 UTC (low-traffic, ingest sonrası) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>0</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/peyman/price-action-bot/logs/launchd/dbbackup.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/peyman/price-action-bot/logs/launchd/dbbackup.stderr.log</string>
</dict>
</plist>
