<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.priceaction.futures15m</string>

  <!--
    futures_daemon.py — 15m wide-stop paper daemon.

    AKTİF olarak launchctl tarafından yönetiliyor (2026-05-25'ten beri).
    PID dinamik (KeepAlive: Crashed=true, SuccessfulExit=false ile yeniden başlar).
    Restart: `launchctl kickstart -k gui/501/com.priceaction.futures15m`

    İki daemon aynı anda = çift emir = felaket. Manuel başlatma YAPMA,
    sadece launchctl kickstart kullan.

    UYARI: Code değişikliği sonrası `kickstart -k` ile restart şart
    (Python module cache temizliği).

    Detay: ops/launchd/README.md §3
  -->

  <key>ProgramArguments</key>
  <array>
    <string>/Users/peyman/price-action-bot/.venv/bin/python</string>
    <string>-u</string>
    <string>scripts/futures_daemon.py</string>
    <string>--timeframe</string>
    <string>15m</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/peyman/price-action-bot</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/peyman/price-action-bot/src</string>
    <key>PA_RUN_MODE</key>
    <string>paper</string>
    <key>TZ</key>
    <string>UTC</string>
    <!-- FIX 2026-05-26 (C1): defansif buffer flush — log() zaten fsync yapıyor -->
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <!-- DEPLOY 2026-05-26: Wide-stop v2 + VSA amplify (en iyi versiyon).
         c2v5 baseline ~%0/ay honest; widestop v2 +%17.56/ay, 0/61 neg ay,
         OOS PASS. Önceden c2v5 default kullanılıyordu (eski versiyon).
         Backtest ref: config dosyası başlık yorumu. -->
    <key>PA_15M_CONFIG</key>
    <string>configs/risk_phoenix_scalp_15m_widestop_vsa2.yaml</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/peyman/price-action-bot/logs/launchd/futures15m.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/peyman/price-action-bot/logs/launchd/futures15m.stderr.log</string>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>
</dict>
</plist>
